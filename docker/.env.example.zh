
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写 OPENAI_API_KEY 和 LANGSMITH_API_KEY
# 3. 填写 HOST_IP
# 4. 可选填写 TAVILY_SEARCH_KEY 启用搜索
# 5. 根据需要调整功能开关 (USE_PPT/USE_EXCEL)
# 6. 保存文件并启动应用
# ============================================

# ============================================
# API 密钥配置 - 项目运行必需的认证信息
# ============================================

# SiliconFlow API 密钥 (必需)
# 作用：用于访问硅基流动的AI模型服务
# 免费额度获取地址: https://cloud.siliconflow.cn/i/FVis58aF
# 提示：注册后可在控制台查看API密钥
OPENAI_API_KEY=

# LangChain 项目名称
# 作用：在LangSmith中组织和分类你的追踪数据
# 说明：所有追踪记录会归类到这个项目下，方便管理多个应用
LANGCHAIN_PROJECT="all_agent"

# 启用 LangChain 追踪功能 (版本2)
# 作用：开启自动追踪LangChain应用的所有LLM调用和链执行
# 说明：设为 true 后，所有LangChain操作会自动发送到LangSmith平台
# 提示：调试时设为true，生产环境可根据需要关闭以减少开销
LANGCHAIN_TRACING_V2=true

# Tavily 搜索 API 密钥 (可选)
# 作用：如果设置此密钥，将启用联网搜索功能
# 免费注册地址: https://tavily.com/
# 提示：不设置此密钥则禁用联网搜索，仅使用本地知识
TAVILY_SEARCH_KEY=


# ============================================
# 服务器网络配置
# ============================================

# 主机IP地址 - 服务器绑定的网络接口IP(必须)
# 作用:
# 1. Agent制作了文件后, MINIO会生成一个下载链接, 用户可下载文件, 该下载链接会以HOST_IP开头。
# 2. 前端程序会以HOST_IP的路径访问后端程序。
# 注意: 需要外部可访问的IP地址也可是域名, 如无公网接口，则填写本地内网IP, 不可填写localhost或127.0.0.1
HOST_IP =

# MinIO对象存储服务端口 - 用于文件存储和访问
MINIO_PORT = 9900

# MinIO控制台端口 - 用于访问MinIO管理界面
MINIO_CONSOLE_PORT = 9901

# MinIO访问密钥 - 用于API认证的用户名
MINIO_ACCESS_KEY=minioadmin

# MinIO秘密密钥 - 用于API认证的密码
MINIO_SECRET_KEY=minioadmin

# Agent前端界面端口 - Web用户界面访问端口
AGENT_UI_PORT=3000

# Agent后端服务端口 - API服务访问端口
AGENT_SERVER_PORT=8000

# ============================================
# 应用功能配置 - 控制项目各项功能的开关
# ============================================

# 允许后台任务中的阻塞循环
# 说明：保持此固定值以实现隔离循环，避免任务相互干扰
# 可选值：true/false
BG_JOB_ISOLATED_LOOPS=true

# 启用 PowerPoint 创建功能
# 说明：设置为true时，AI可以创建和编辑PPT文档
# 可选值：true/false
USE_PPT=true

# 启用 Excel 创建功能
# 说明：设置为true时，AI可以创建和编辑Excel表格
# 可选值：true/false
USE_EXCEL=true

# ============================================
# 模型配置 - AI模型选择和参数设置
# ============================================

# 基础大语言模型 (LLM)
# 说明：用于文本生成和对话的主模型
# 可选值：Qwen/Qwen3-30B-A3B-Instruct-2507、Qwen/Qwen3-Next-80B-A3B-Instruct等
BASE_LLM=Qwen/Qwen3-Next-80B-A3B-Instruct

# 基础视觉语言模型 (VLM)
# 说明：用于图像理解和多模态任务
BASE_VLM=Qwen/Qwen3-VL-30B-A3B-Instruct

# 图像生成模型
# 说明：用于根据文本描述生成图像
IMAGE_MODEL=Qwen/Qwen-Image

# 图像编辑模型
# 说明：用于修改和编辑现有图像
EDIT_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509

# 模型 API 基础地址
# 说明：所有模型请求发送到的API端点
MODEL_API_BASE_URL=https://api.siliconflow.cn/v1