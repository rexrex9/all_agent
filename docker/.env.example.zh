# ============================================
# API 密钥配置 - 项目运行必需的认证信息
# ============================================

# SiliconFlow API 密钥 (必需)
# 作用：用于访问硅基流动的AI模型服务
# 免费额度获取地址: https://cloud.siliconflow.cn/i/FVis58aF
# 提示：注册后可在控制台查看API密钥
OPENAI_API_KEY=

# LangSmith API 密钥 (必需)
# 作用：用于LangChain的追踪和监控功能
# 免费注册地址: https://www.langsmith.com/
# 提示：注册后可在设置页面生成API密钥
LANGSMITH_API_KEY=

# Tavily 搜索 API 密钥 (可选)
# 作用：如果设置此密钥，将启用联网搜索功能
# 免费注册地址: https://tavily.com/
# 提示：不设置此密钥则禁用联网搜索，仅使用本地知识
TAVILY_SEARCH_KEY=

# ============================================
# 应用功能配置 - 控制项目各项功能的开关
# ============================================

# 允许后台任务中的阻塞循环
# 说明：保持此固定值以实现隔离循环，避免任务相互干扰
# 可选值：true/false
BG_JOB_ISOLATED_LOOPS=true

# 启用 PowerPoint 创建功能
# 说明：设置为true时，AI可以创建和编辑PPT文档
# 可选值：true/false
USE_PPT=true

# 启用 Excel 创建功能
# 说明：设置为true时，AI可以创建和编辑Excel表格
# 可选值：true/false
USE_EXCEL=true

# ============================================
# 模型配置 - AI模型选择和参数设置
# ============================================

# 基础大语言模型 (LLM)
# 说明：用于文本生成和对话的主模型
# 可选值：Qwen/Qwen3-30B-A3B-Instruct-2507、Qwen/Qwen3-Next-80B-A3B-Instruct等
BASE_LLM=Qwen/Qwen3-Next-80B-A3B-Instruct

# 基础视觉语言模型 (VLM)
# 说明：用于图像理解和多模态任务
BASE_VLM=Qwen/Qwen3-VL-30B-A3B-Instruct

# 图像生成模型
# 说明：用于根据文本描述生成图像
IMAGE_MODEL=Qwen/Qwen-Image

# 图像编辑模型
# 说明：用于修改和编辑现有图像
EDIT_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509

# 模型 API 基础地址
# 说明：所有模型请求发送到的API端点
# 注意：除非自建服务，否则不要修改此地址
MODEL_API_BASE_URL=https://api.siliconflow.cn/v1

# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写 OPENAI_API_KEY 和 LANGSMITH_API_KEY
# 3. 可选填写 TAVILY_SEARCH_KEY 启用搜索
# 4. 根据需要调整功能开关 (USE_PPT/USE_EXCEL)
# 5. 保存文件并启动应用
# ============================================